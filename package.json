{
  "name": "context-kit-packages",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter './packages/*' build",
    "typecheck": "bun --filter './packages/*' typecheck",
    "test": "bun --filter './packages/*' test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4"
  }
}
