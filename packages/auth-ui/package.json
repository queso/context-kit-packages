    "@types/bun": "^1.3.9",
    "@types/react": "^19.1.5",
    "happy-dom": "^17.4.4",
    "next": ">=14.0.0",
    "react": "^19.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
