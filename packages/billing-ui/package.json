{
  "name": "@context-kit/billing-ui",
  "version": "0.1.0",
  "description": "UI components for context-kit billing, powered by Stripe",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000"
  },
  "dependencies": {
    "@stripe/stripe-js": "^5.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  },
  "peerDependencies": {
    "@context-kit/billing": ">=0.1.0",
    "@stripe/react-stripe-js": ">=3.0.0",
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@context-kit/billing": "workspace:*",
    "@stripe/react-stripe-js": "^3.0.0",
    "@stripe/stripe-js": "^5.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.9",
    "@types/react": "^19.1.5",
    "happy-dom": "^17.4.4",
    "next": ">=14.0.0",
    "react": "^19.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
