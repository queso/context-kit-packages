{
  "name": "@context-kit/error-tracker",
  "version": "0.1.0",
  "description": "Error tracking for context-kit projects, stored in the app's own database via Drizzle",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./schema/sqlite": {
      "types": "./dist/schema/sqlite.d.ts",
      "import": "./dist/schema/sqlite.js",
      "default": "./dist/schema/sqlite.js"
    },
    "./schema/postgres": {
      "types": "./dist/schema/postgres.d.ts",
      "import": "./dist/schema/postgres.js",
      "default": "./dist/schema/postgres.js"
    }
  },
  "bin": {
    "error-tracker": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "source-map": "^0.7.4"
  },
  "peerDependencies": {
    "@libsql/client": ">=0.14.0",
    "drizzle-orm": ">=0.41.0",
    "next": ">=14.0.0",
    "postgres": ">=3.4.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.9",
    "@types/react": "^19.1.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "happy-dom": "^17.4.4",
    "next": ">=14.0.0",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
