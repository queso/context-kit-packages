{
  "name": "@context-kit/auth",
  "version": "0.2.0",
  "description": "Authentication for context-kit projects, powered by Better Auth + Drizzle",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "default": "./dist/middleware.js"
    },
    "./schema/sqlite": {
      "types": "./dist/schema/sqlite.d.ts",
      "import": "./dist/schema/sqlite.js",
      "default": "./dist/schema/sqlite.js"
    },
    "./schema/postgres": {
      "types": "./dist/schema/postgres.d.ts",
      "import": "./dist/schema/postgres.js",
      "default": "./dist/schema/postgres.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "better-auth": "^1.4.18"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.41.0",
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@types/bun": "^1.3.9",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "next": ">=14.0.0",
    "postgres": "^3.4.9",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
