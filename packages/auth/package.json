{
  "name": "@context-kit/auth",
  "version": "0.1.0",
  "description": "Authentication for context-kit projects, powered by Better Auth + Prisma",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "better-auth": "^1.4.18"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0",
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/client": ">=5.0.0",
    "@types/bun": "^1.3.9",
    "next": ">=14.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
